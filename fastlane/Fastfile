default_platform(:ios)

require "shellwords"

APP_ID = "com.jigaoyi.mikaweb"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Create or sync App Store signing assets"
  lane :certs do |options|
    match(api_key: asc_api_key, type: "appstore", app_identifier: APP_ID,
          readonly: options.fetch(:readonly, false))
  end

  desc "Build and upload Mika Web to TestFlight"
  lane :beta do
    setup_ci
    api_key = asc_api_key
    match(api_key: api_key, type: "appstore", app_identifier: APP_ID, readonly: true)
    update_code_signing_settings(
      path: "MikaWeb.xcodeproj",
      use_automatic_signing: false,
      team_id: "6566672L5G",
      targets: ["MikaWeb"],
      profile_name: "match AppStore com.jigaoyi.mikaweb",
      code_sign_identity: "Apple Distribution"
    )
    increment_build_number(build_number: Time.now.strftime("%Y%m%d%H%M"))
    build_sha = sh("git rev-parse HEAD").strip
    archive_path = File.expand_path("../build/MikaWeb.xcarchive", __dir__)
    build_app(
      scheme: "MikaWeb",
      export_method: "app-store",
      archive_path: archive_path,
      xcargs: "MIKA_BUILD_SHA=#{build_sha}",
      export_options: {
        provisioningProfiles: {
          APP_ID => "match AppStore com.jigaoyi.mikaweb"
        }
      }
    )
    archived_plist = File.join(archive_path, "Products/Applications/MikaWeb.app/Info.plist")
    archived_sha = sh("/usr/libexec/PlistBuddy -c 'Print :MikaBuildSHA' #{Shellwords.escape(archived_plist)}").strip
    UI.user_error!("Archived MikaBuildSHA mismatch: expected #{build_sha}, got #{archived_sha}") unless archived_sha == build_sha
    UI.success("Archived MikaBuildSHA=#{archived_sha}")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Show recent TestFlight processing states"
  lane :tf_status do
    asc_api_key
    builds = Spaceship::ConnectAPI::Build.all(app_id: ENV.fetch("ASC_APP_ID"))
    builds.first(5).each do |build|
      UI.message("BUILD appver=#{build.pre_release_version&.version} build=#{build.version} state=#{build.processing_state} expired=#{build.expired} uploaded=#{build.uploaded_date}")
    end
  end
end
