default_platform(:ios)

APP_ID = "com.jigaoyi.mikaweb"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Create or sync App Store signing assets"
  lane :certs do |options|
    match(api_key: asc_api_key, type: "appstore", app_identifier: APP_ID,
          readonly: options.fetch(:readonly, false))
  end

  desc "Build and upload Mika Web to TestFlight"
  lane :beta do
    setup_ci
    api_key = asc_api_key
    match(api_key: api_key, type: "appstore", app_identifier: APP_ID, readonly: true)
    update_code_signing_settings(
      path: "MikaWeb.xcodeproj",
      use_automatic_signing: false,
      team_id: "6566672L5G",
      targets: ["MikaWeb"],
      profile_name: "match AppStore com.jigaoyi.mikaweb",
      code_sign_identity: "Apple Distribution"
    )
    increment_build_number(build_number: Time.now.strftime("%Y%m%d%H%M"))
    build_app(
      scheme: "MikaWeb",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_ID => "match AppStore com.jigaoyi.mikaweb"
        }
      }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Show recent TestFlight processing states"
  lane :tf_status do
    asc_api_key
    builds = Spaceship::ConnectAPI::Build.all(app_id: ENV.fetch("ASC_APP_ID"))
    builds.first(5).each do |build|
      UI.message("BUILD appver=#{build.pre_release_version&.version} build=#{build.version} state=#{build.processing_state} expired=#{build.expired} uploaded=#{build.uploaded_date}")
    end
  end
end
